# =============================================================================
# CardFlow — Frontend Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# In development: leave empty — Vite's proxy routes /api/* to the local Django server.
# In production (standalone frontend deployment): set to your deployed API URL.
# Example: VITE_API_BASE_URL=https://panel.adarshbhopal.in
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------

# Django backend port for the Vite dev proxy. Default: 8008
# Change if your local Django runs on a different port.
VITE_DJANGO_PORT=8008
