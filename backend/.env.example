# =============================================================================
# CardFlow — Backend Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DJANGO CORE
# -----------------------------------------------------------------------------

# REQUIRED. Generate a secure key (50+ chars):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set False in production. True in local development only.
DEBUG=False

# REQUIRED in production (DEBUG=False). Comma-separated hostnames.
# Example: ALLOWED_HOSTS=adarshbhopal.in,www.adarshbhopal.in,panel.adarshbhopal.in
ALLOWED_HOSTS=

# App version (auto-detected from VERSION.txt if omitted)
# APP_VERSION=5.7.0

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# REQUIRED. PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Alternative component form (used only if DATABASE_URL is not set):
# POSTGRES_DB=cardflow_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# REDIS (Cache + WebSocket Channel Layer)
# -----------------------------------------------------------------------------

# Preferred form (single URL):
REDIS_URL=redis://127.0.0.1:6379/1

# Alternative component form (used only if REDIS_URL is omitted):
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=1
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Cache behaviour tuning (optional):
# CACHE_DEFAULT_TIMEOUT=300
# CACHE_KEY_PREFIX=adarsh
# CACHE_VERSION=1
# REDIS_SOCKET_TIMEOUT=1.5
# REDIS_SOCKET_CONNECT_TIMEOUT=1.5
# REDIS_HEALTH_CHECK_INTERVAL=30
# REDIS_MAX_CONNECTIONS=100

# Optional: separate Redis for WebSocket channel layer
# REDIS_CHANNEL_LAYER_URL=redis://127.0.0.1:6379/2
# REDIS_CHANNEL_PREFIX=adarsh:realtime
# REDIS_CHANNEL_CAPACITY=1500
# REDIS_CHANNEL_EXPIRY=30

# -----------------------------------------------------------------------------
# CORS & CSRF
# -----------------------------------------------------------------------------

# REQUIRED in production. Comma-separated allowed frontend origins (with scheme).
# Example: CORS_ALLOWED_ORIGINS=https://panel.adarshbhopal.in,https://www.adarshbhopal.in
CORS_ALLOWED_ORIGINS=

# REQUIRED in production. Same origins as above (for CSRF protection).
CSRF_TRUSTED_ORIGINS=

# DEV ONLY. Set True only in local development to bypass strict origin checking.
# NEVER set True in production.
# CORS_ALLOW_ALL_ORIGINS=False

# -----------------------------------------------------------------------------
# SSL & SECURITY (Production)
# -----------------------------------------------------------------------------

# Redirect all HTTP to HTTPS. Set True in production behind SSL.
SECURE_SSL_REDIRECT=True

# Set True only when Django is behind a reverse proxy (Nginx) that terminates SSL.
# SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
# SECURE_PROXY_SSL_HEADER_VALUE=https

# Force secure cookies even in non-SSL dev environments (for testing):
# FORCE_SECURE_COOKIES=False

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# -----------------------------------------------------------------------------

# When EMAIL_HOST_USER is set, SMTP is used. Otherwise console backend (dev).
EMAIL_HOST=mail.adarshbhopal.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@adarshbhopal.in
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Adarsh Admin <noreply@adarshbhopal.in>

# Recipient address for contact form submissions:
CONTACT_FORM_RECIPIENT=hello@adarshbhopal.in

# Public site URL used in email links:
SITE_URL=https://www.adarshbhopal.in

# -----------------------------------------------------------------------------
# WEB APP API INTEGRATION (Landing Website)
# -----------------------------------------------------------------------------

# REQUIRED in production. Secret key shared between the panel and landing website.
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must match the WEB_APP_API_KEY configured on the landing website server.
WEB_APP_API_KEY=

# Base URL of the landing website (for contact form proxy):
# Production: https://www.adarshbhopal.in
# Local dev:  http://localhost:8001
LANDING_WEBSITE_URL=https://www.adarshbhopal.in

# -----------------------------------------------------------------------------
# SENTRY (Error Monitoring)
# -----------------------------------------------------------------------------

# Leave blank to disable Sentry. Fill in from https://sentry.io/settings/
SENTRY_DSN=

# Fraction of transactions to trace for performance monitoring (0.0 = off, 1.0 = all)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Optional profiling (0.0 = off):
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.1
# SENTRY_PROFILE_LIFECYCLE=trace

# DO NOT send PII (personally identifiable information) to Sentry:
SENTRY_SEND_PII=False
SENTRY_ENABLE_LOGS=False

# -----------------------------------------------------------------------------
# MOBILE APP
# -----------------------------------------------------------------------------

# Minimum mobile app version to allow (older versions are blocked):
LATEST_MOBILE_VERSION=1.1.6

# Android Shell Policy:
MOBILE_SHELL_ANDROID_MIN_BUILD=1
MOBILE_SHELL_ANDROID_LATEST_BUILD=100
MOBILE_SHELL_ANDROID_LATEST_VERSION=1.1.00
MOBILE_SHELL_ANDROID_FORCE_UPDATE=False
MOBILE_SHELL_ANDROID_UPDATE_URL=https://panel.adarshbhopal.in/static/website/apk/adarsh-admin.apk
MOBILE_SHELL_PRIVACY_URL=https://www.adarshbhopal.in/privacy/
MOBILE_SHELL_SUPPORT_URL=https://www.adarshbhopal.in/contact/

# -----------------------------------------------------------------------------
# GUNICORN (Production Process Manager)
# -----------------------------------------------------------------------------

# Tune based on your server resources:
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=2
# GUNICORN_WORKER_CLASS=gthread
# GUNICORN_TIMEOUT=90
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_KEEPALIVE=5
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100
# GUNICORN_BIND=unix:/run/gunicorn.sock

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Enable file-based rotating logs (recommended on VPS/bare-metal):
# LOG_TO_FILE=true

# Timezone:
TIME_ZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# MEDIA & PERFORMANCE
# -----------------------------------------------------------------------------

# Enable Nginx X-Accel-Redirect for protected media (requires nginx config):
# MEDIA_USE_XACCEL=false

# Max upload size (bytes). Default: 512 MB.
# DATA_UPLOAD_MAX_MEMORY_SIZE=536870912
# FILE_UPLOAD_MAX_MEMORY_SIZE=26214400
# DATA_UPLOAD_MAX_NUMBER_FILES=6000

# Background worker threads:
# BACKGROUND_WORKER_MAX_WORKERS=2
# BACKGROUND_HEAVY_TASK_CONCURRENCY=1

# Session settings:
# SESSION_IDLE_TIMEOUT=2592000
# SESSION_ABSOLUTE_MAX_AGE=2592000
# DASHBOARD_LIVE_ACTIVE_WINDOW_SECONDS=300

